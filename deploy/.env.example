# Copy to a private, ignored file such as runtime/deploy.env; pass --env-file.
# Use the reviewed Git commit id as image tag, keeping previous images for rollback.
VIBEEVAL_IMAGE_TAG=
POSTGRES_DB=vibeeval
POSTGRES_USER=vibeeval
POSTGRES_PASSWORD=
VIBEEVAL_HTTP_PORT=8080
# true when the browser-facing URL uses HTTPS; local HTTP validation uses false.
COOKIE_SECURE=false

# Only required with -f deploy/compose.gvisor.yml on a Linux/gVisor host.
SANDBOX_BACKEND_REF=docker-gvisor:exam-node-01
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
# Obtain using: stat -c %g /var/run/docker.sock
SANDBOX_DOCKER_GID=
SANDBOX_REQUEST_TIMEOUT=20
SANDBOX_OPERATION_TIMEOUT=45
SANDBOX_IMAGE_REF=
SANDBOX_TASK_VERSION=python-debug-01:f898a77
# Exact public browser origin; empty disables terminal connections.
SANDBOX_TERMINAL_ORIGINS=http://localhost:8080
