# Local development only. Copy this file to .env at the repository root.
# Choose a local password before starting Docker Compose; an empty value is rejected.
POSTGRES_DB=vibeeval
POSTGRES_USER=vibeeval
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1

# Host ports. Change these if another local service already uses the default port.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional backend override: DATABASE_URL takes precedence over POSTGRES_* settings.
# Both postgresql:// and postgresql+psycopg:// are supported; URL-encode credentials.
# DATABASE_URL=
